# Ribath Staging frontend only. Never place service-role or database secrets here.
NEXT_PUBLIC_SUPABASE_URL=https://ayrzgpoxbvwtdkzqktze.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-staging-publishable-or-anon-key

# Local staging backend. Replace both values with the hosted staging backend URL
# when a separate backend deployment is created.
