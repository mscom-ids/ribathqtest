PARENT_PORTAL_HOST=parents.staging.localhost
NEXT_PUBLIC_ENABLE_ADMIN_NOTIFICATIONS=false
NEXT_PUBLIC_ENABLE_DASHBOARD_EVENTS=false
NEXT_PUBLIC_ENABLE_DASHBOARD_DELEGATIONS=false
