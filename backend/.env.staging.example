# Ribath Staging backend only. These values must never point at production.
NODE_ENV=production
APP_ENV=staging
PORT=5001
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=replace-with-ribath-staging-supabase-pooler-url
DB_SSL=true
DB_POOL_MAX=4
DB_POOL_MIN=0
DB_POOL_WARM_CONNECTIONS=1

SUPABASE_URL=https://ayrzgpoxbvwtdkzqktze.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-staging-secret-or-service-role-key

JWT_SECRET=replace-with-at-least-32-random-bytes
MOBILE_ACCESS_TOKEN_TTL_SECONDS=900
MOBILE_REFRESH_TOKEN_TTL_DAYS=30
MOBILE_SESSION_FAMILY_TTL_DAYS=90

# Optional synthetic account used only by npm run seed:staging:mobile.
STAGING_TEST_MENTOR_EMAIL=mobile.mentor@staging.ribath.invalid
STAGING_TEST_MENTOR_PASSWORD=replace-with-a-random-16-plus-character-password
